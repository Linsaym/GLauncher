{
  "name": "@glauncher/client",
  "productName": "GLauncher",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/main/index.js",
  "scripts": {
    "build": "tsc -p tsconfig.main.json && vite build",
    "typecheck": "tsc --noEmit -p tsconfig.main.json && tsc -p tsconfig.renderer.json",
    "pretest": "npm run build",
    "test": "node --test",
    "prestart": "npm run build",
    "start": "electron .",
    "package:win": "npm run build && electron-builder --win --x64 --dir && tar.exe -a -cf release/GLauncher-Windows-x64.zip -C release/win-unpacked .",
    "package:setup": "npm run build && electron-builder --win nsis --x64"
  },
  "dependencies": {
    "prismarine-nbt": "2.8.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "build": {
    "appId": "org.glauncher.client",
    "electronDist": "../../node_modules/electron/dist",
    "npmRebuild": false,
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "assets/**/*"
    ],
    "win": {
      "icon": "assets/logo.ico",
      "signExecutable": false
    },
    "nsis": {
      "artifactName": "GLauncher-Setup.exe"
    }
  },
  "devDependencies": {
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "electron": "45.4.1",
    "electron-builder": "26.18.0",
    "vite": "8.3.8"
  }
}
